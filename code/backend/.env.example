# Copy this file to .env and fill in the keys (get them from Abby). Never commit .env.
WA_API_KEY=
OR_API_KEY=
ID_API_KEY=

# Optional settings
# USE_SAMPLE_DATA=1                         # use sample_data/ even when keys are set (offline demos)
# CACHE_SECONDS=60                          # how long to reuse a DOT response (matches the map's 60s refresh)
# STALE_LIMIT_SECONDS=1800                  # how long to keep serving last good data if a DOT API goes down
# ALLOWED_ORIGINS=https://diogee23.github.io  # lock CORS to our site (default allows any origin)
# PORT=5001
